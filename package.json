{
  "name": "outside-access-guard",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "SilverCrossing",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilverCrossing/outside-access-guard.git"
  },
  "type": "module",
  "description": "Three-mode gate for tool access outside the session workspace: deny, per-call approval with high-risk double confirmation, or allow; every decision is logged per day.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "classify.js",
    "log.js",
    "scope.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0"
  }
}
